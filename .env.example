# PayPilot Environment Configuration Template
# Duplicate this file as .env and configure your secrets locally.
# DO NOT COMMIT .env TO VERSION CONTROL.

# Application Configuration
APP_NAME=PayPilot
ENVIRONMENT=development
PORT=8000
DEBUG=false

# ==============================================================================
# Authentication & Identity Verification (Phase 4A)
# ==============================================================================
# AUTH_MODE: "demo" (for local offline dev/tests) or "jwt" (mandatory in production)
AUTH_MODE=demo

# OIDC / JWKS Identity Provider settings (e.g. Supabase Auth, Auth0, Okta)
# Mandatory when AUTH_MODE=jwt or ENVIRONMENT=production:
AUTH_ISSUER=https://<your-idp-domain>.com/
AUTH_AUDIENCE=paypilot-api
AUTH_JWKS_URL=https://<your-idp-domain>.com/.well-known/jwks.json
AUTH_ALGORITHMS=["RS256"]
AUTH_REQUIRED_CLAIMS=["sub"]
AUTH_CLOCK_SKEW_SECONDS=60

# ==============================================================================
# Database Configuration (Phase 2 & Phase 4A)
# ==============================================================================
# Local Development & Automated Tests (SQLite default):
DATABASE_URL=sqlite:///./paypilot.db

# Production Deployment (PostgreSQL):
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Normalized automatically to psycopg3: postgresql+psycopg://...
# Example: DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paypilot_prod
POSTGRES_TEST_DATABASE_URL=postgresql+psycopg://paypilot_test:test_password_secure_123@localhost:5432/paypilot_test
REQUIRE_POSTGRES=0

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ==============================================================================
# Security & Agent Policy (Phase 3)
# ==============================================================================
# Maximum steps per agent conversational turn before halting runaway execution
AGENT_MAX_STEPS=12

# Session expiration TTL in seconds (Default: 86400s = 24 hours)
AGENT_SESSION_EXPIRY_SECONDS=86400

# High-risk tool policy (true = all purchases and support tickets require explicit approval)
REQUIRE_APPROVAL_ALL_PURCHASES=true
MAX_AUTO_PURCHASE_AMOUNT=0.0

# ==============================================================================
# AI Agent Layer
# ==============================================================================
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-2.5-pro

# ==============================================================================
# PayPal Integration (Sandbox)
# ==============================================================================
# Obtain Sandbox Client ID and Secret from PayPal Developer Dashboard:
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_ENVIRONMENT=sandbox

# Set to false to disable local mock fallback and strictly require valid PayPal credentials
PAYPAL_MOCK_ENABLED=true
