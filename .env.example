# PayPilot Environment Configuration Template
# Duplicate this file as .env and configure your secrets locally.
# DO NOT COMMIT .env TO VERSION CONTROL.

# Application Configuration
APP_NAME=PayPilot
ENVIRONMENT=development
PORT=8000
DEBUG=false

# Database Configuration (PostgreSQL / SQLite ready)
DATABASE_URL=sqlite+aiosqlite:///./paypilot.db

# AI Agent Layer (Phase 2+)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-2.5-pro

# PayPal Integration (Phase 3+)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_ENVIRONMENT=sandbox
