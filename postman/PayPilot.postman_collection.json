{
  "info": {
    "_postman_id": "paypilot-api-collection-v2",
    "name": "PayPilot Agentic Commerce API",
    "description": "Comprehensive Postman test collection for PayPilot (PayPal AI Hackathon). Covers PayPal Sandbox, Channel3, Elasticsearch, Kernel Browser, Zapier Automation, Bryntum Timeline, and AG Grid Analytics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Health & Infrastructure",
      "item": [
        {
          "name": "API Root Info",
          "request": {
            "method": "GET",
            "header": [],
