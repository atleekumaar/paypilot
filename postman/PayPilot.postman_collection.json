    {
      "name": "02 - Product Discovery & Catalog",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/?limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", ""],
              "query": [{ "key": "limit", "value": "5" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Products returned', function () {",
                  "    var json = pm.response.json();",
                  "    var items = json.items || json;",
                  "    pm.expect(items.length).to.be.above(0);",
                  "    pm.environment.set('test_product_id', items[0].id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Product Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{test_product_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{test_product_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Valid product structure', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('name');",
                  "    pm.expect(json).to.have.property('price');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Channel3 Universal Retailers",
      "item": [
        {
          "name": "Channel3 Live Product Search",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"running shoes\",\n  \"limit\": 3\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/channel3/search", "host": ["{{baseUrl}}"], "path": ["api", "channel3", "search"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Channel3 items returned', function () {",
                  "    var json = pm.response.json();",
                  "    var items = Array.isArray(json) ? json : (json.results || []);",
                  "    pm.expect(items.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Channel3 Multi-Retailer Comparison",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_ids\": [\"c3_prod_apple_macbook_air_m3\", \"c3_prod_dell_xps_15\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/channel3/compare", "host": ["{{baseUrl}}"], "path": ["api", "channel3", "compare"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Comparison matrix populated', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('products');",
                  "    pm.expect(json.total_compared).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
