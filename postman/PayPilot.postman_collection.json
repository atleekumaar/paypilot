          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Application is PayPilot', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.name).to.eql('PayPilot');",
                  "    pm.expect(json.status).to.eql('running');",
                  "});"
                ],
                "type": "text/javascript"
              }
