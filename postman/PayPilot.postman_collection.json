    {
      "name": "05 - Kernel Cloud Browser",
      "item": [
        {
          "name": "Browse & Verify Merchant Page",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://www.target.com/p/apple-macbook-air-m3\",\n  \"extract_policy\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/kernel/browse", "host": ["{{baseUrl}}"], "path": ["api", "kernel", "browse"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Browser inspection successful', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('SUCCESS');",
                  "    pm.expect(json).to.have.property('replay_url');",
                  "    pm.expect(json.bot_bypass_success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Verify Merchant Domain Trust",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"domain\": \"target.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/kernel/verify-domain", "host": ["{{baseUrl}}"], "path": ["api", "kernel", "verify-domain"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Domain verified', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('VERIFIED_MERCHANT');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 - Zapier Workflow Automation",
      "item": [
        {
          "name": "Dispatch Event to Zapier (Sheets, Slack, Gmail)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"order_completed\",\n  \"payload\": {\n    \"order_id\": \"ord_test_999\",\n    \"product_name\": \"Pro Developer Laptop\",\n    \"total_amount\": 1299.99,\n    \"currency\": \"USD\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/zapier/dispatch", "host": ["{{baseUrl}}"], "path": ["api", "zapier", "dispatch"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Zapier dispatch status valid', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(['DISPATCHED', 'SUCCESS_SIMULATED']).to.include(json.status);",
                  "    pm.expect(json.target_apps.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Inbound Zapier Webhook Callback",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"zap_id\": \"zap_12345\",\n  \"action\": \"inventory_sync\",\n  \"sku\": \"PROD-123\",\n  \"status\": \"confirmed\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/zapier/webhook", "host": ["{{baseUrl}}"], "path": ["api", "zapier", "webhook"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Webhook accepted', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('ACCEPTED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
